#!/bin/bash
set -euo pipefail

if ! command -v gum &>/dev/null; then
  echo "Error: gum is not installed or not on PATH"
  exit 1
fi

# Colours
RED="\e[38;2;197;26;74m"
GREEN="\e[32m"
BLUE="\e[34m"
CYAN="\e[36m"
YELLOW="\e[33m"
MAGENTA="\e[35m"
BOLD="\e[1m"
DIM="\e[2m"
RESET="\e[0m"


# Helpers
header() {
  echo -e "${RED}${BOLD}  $1${RESET}"
  echo -e "${DIM}  $(printf '─%.0s' {1..50})${RESET}"
}

section() {
  echo ""
  echo -e "${CYAN}${BOLD}  $1${RESET}"
}

cmd() {
  # cmd "alias" "description"
  printf "  ${GREEN}%-28s${RESET} %s\n" "$1" "$2"
}

qcmd() {
  # qcmd "command" "description" — wider column for opencode-quota flags
  printf "  ${GREEN}%-46s${RESET} %s\n" "$1" "$2"
}

hotkey() {
  # hotkey "keys" "description"
  printf "  ${YELLOW}%-28s${RESET} %s\n" "$1" "$2"
}


# Pages
page_commands() {
  clear
  echo ""
  header "Oma-Pi Commands"

  section "Scripts"
  cmd "omapi-help"    "Show this help"
  cmd "omapi-refresh" "Reinstall Oma-Pi with initial configs"
  cmd "omapi-setup"   "Set git name, email and GitHub CLI auth"
  cmd "omapi-ssh"     "Add SSH key for remote access"

  section "AI Tools"
  cmd "oc"  "opencode"
  cmd "cc"  "claude --permission-mode bypassPermissions"
  cmd "ha"  "hermes"
  cmd "opencode-quota" "Opencode Go plan usage and quota"

  section "Docker"
  cmd "d"   "docker"
  cmd "lzd" "lazydocker"

  section "Herdr"
  cmd "h"   "herdr --session Work"
  cmd "ic"  "hdl oc"
  cmd "ix"  "hdl ha"
  cmd "icx" "hdl oc ha"
  cmd "hdl [ai] [ai2]"               "Dev layout: editor + AI pane(s) + terminal"
  cmd "hdl oc"                       "Editor + opencode"
  cmd "hdl cc"                       "Editor + claude"
  cmd "hdl oc cc"                    "Editor + opencode + claude"
  cmd "hdlm [ai] [ai2]"              "One hdl tab per subdirectory"
  cmd "hds"                          "Dev square: editor + diff watch + opencode"
  cmd "hsl <count> <command>"        "Swarm layout: N panes running same command"

  section "Git"
  cmd "g"    "git"
  cmd "gcm"  "git commit -m"
  cmd "gcam" "git commit -a -m"
  cmd "g co" "git checkout"
  cmd "g br" "git branch"
  cmd "g ci" "git commit"
  cmd "g st" "git status"
  cmd "gh"   "github cli"
  cmd "ga <branch>"                  "Create worktree + branch, cd into it"
  cmd "gd"                           "Remove current worktree + branch"
  cmd "git-id"                       "Set global git user.name and user.email"

  section "File & Navigation"
  cmd "y"    "file manager (Yazi, cds on exit)"
  cmd "ff"  "fzf fuzzy finder"
  cmd "eff"  "fzf fuzzy finder in editor (MS Edit)"
  cmd "cd"  "zoxide (smart cd)"
  cmd ".."  "cd .."
  cmd "..."  "cd ../.."
  cmd "...."  "cd ../../.."
  cmd "ls"  "eza"
  cmd "lt"  "eza tree (2 levels)"
  cmd "lsa" "eza including hidden"
  cmd "lta" "eza tree including hidden"

  section "Productivity"
  cmd "tb"  "tuiboard (terminal kanban on markdown)"

  section "SSH Port Forwarding"
  cmd "fip <host> <port...>"           "Forward port(s) from remote host"
  cmd "dip <port...>"                  "Stop forwarding port(s)"
  cmd "lip"                            "List active port forwards"

  section "System"
  cmd "btop" "resource monitor"
  cmd "tldr" "simplified man pages"
}

page_quota() {
  clear
  echo ""
  header "OpenCode Quota"
  echo -e "  ${DIM}Reads the quota opencode saved last; opencode can stay closed.${RESET}"

  section "Usage"
  qcmd "opencode-quota show"                           "Go plan: 5h / Weekly / Monthly bars"
  qcmd "opencode-quota show --json"                    "The same cached data as JSON"
  qcmd "opencode-quota show --provider opencode-go"    "Only the Go plan"
  qcmd "opencode-quota show --json --provider copilot" "Only Copilot"

  section "Thresholds (for CI)"
  qcmd "opencode-quota show --json --threshold 5" "Exit 1 when comparable quota is below 5%"
  cmd "0" "Complete, nothing below the threshold"
  cmd "1" "Quota below the threshold, or the command failed"
  cmd "2" "Results incomplete, or no comparable percentage"

  section "Without the global install"
  qcmd "bunx --bun @slkiser/opencode-quota@latest show" "Same data, opencode can stay closed"
}

page_herdr() {
  clear
  echo ""
  header "Herdr Reference"
  echo -e "  ${DIM}Prefix = Ctrl + B (Herdr default)${RESET}"
  echo -e "  ${DIM}Press Prefix ? for the live list of every active binding.${RESET}"

  section "Panes"
  hotkey "Prefix v"            "Split pane left/right"
  hotkey "Prefix -"            "Split pane top/bottom"
  hotkey "Prefix x"            "Close pane"
  hotkey "Prefix z"            "Toggle pane zoom"
  hotkey "Prefix r"            "Resize mode"
  hotkey "Prefix h / j / k / l" "Focus pane left / down / up / right"
  hotkey "Prefix Tab"          "Cycle to the next pane"

  section "Tabs"
  hotkey "Prefix c"            "New tab"
  hotkey "Prefix Shift+T"      "Rename tab"
  hotkey "Prefix Shift+X"      "Close tab"
  hotkey "Prefix p / n"        "Previous / next tab"
  hotkey "Prefix 1 .. 9"       "Go to tab by number"

  section "Workspaces"
  hotkey "Prefix Shift+N"      "New workspace"
  hotkey "Prefix Shift+W"      "Rename workspace"
  hotkey "Prefix Shift+D"      "Close workspace"
  hotkey "Prefix w"            "Open workspace picker"
  hotkey "Prefix g"            "Go to workspace or agent"

  section "Sessions"
  hotkey "Prefix q"            "Detach from Herdr"
  hotkey "h"                   "Attach to (or start) the Work session"
  hotkey "herdr session list"  "List sessions"
  hotkey "herdr session attach <name>" "Attach to a named session"

  section "Other"
  hotkey "Prefix ?"            "Show all key bindings"
  hotkey "Prefix s"            "Open settings"
  hotkey "Prefix Shift+R"      "Reload Herdr config"
  hotkey "Prefix e"            "Edit scrollback"
  hotkey "Prefix b"            "Toggle sidebar"
  hotkey "Mouse"               "Click, drag, and right-click to manage panes"

  section "Oma-Pi layouts"
  cmd "hdl [ai] [ai2]"         "Dev layout: editor + AI pane(s) + terminal"
  cmd "hdlm [ai] [ai2]"        "One hdl tab per subdirectory"
  cmd "hds"                    "Dev square: editor + diff watch + opencode"
  cmd "hsl <count> <command>"  "Swarm layout: N panes running same command"
}

page_functions() {
  clear
  echo ""
  header "Functions"

  section "Drives"
  cmd "iso2sd <iso> [device]"        "Write an ISO to an SD card / USB drive"
  cmd "format-drive <device> <name>" "Wipe and format a whole drive as exFAT"

  section "Files"
  cmd "sff <destination>"            "Pick a file with fzf and scp it away"
  cmd "compress <path>"              "tar.gz a file or directory"
  cmd "decompress <file.tar.gz>"     "Extract a tar.gz archive"

  section "Worktrees"
  cmd "ga <branch>"                  "Create worktree + branch, cd into it"
  cmd "gd"                           "Remove current worktree + branch"

  section "SSH Port Forwarding"
  cmd "fip <host> <port...>"         "Forward port(s) from a remote host"
  cmd "dip <port...>"                "Stop forwarding port(s)"
  cmd "lip"                          "List active port forwards"
}



# Main menu
while true; do
  clear
  echo ""
  echo -e "${RED}   
 ▄██████▄    ▄▄▄▄███▄▄▄▄      ▄████████    ▄████████ ▄██
███    ███ ▄██▀▀▀███▀▀▀██▄   ███    ███   ███    ███ █▀
███    ███ ███   ███   ███   ███    ███   ███    ███   ▄
███    ███ ███   ███   ███   ███    ███   ███    ███ ▄██
███    ███ ███   ███   ███ ▀███████████ ▀█████████▀  ███
███    ███ ███   ███   ███   ███    ███   ███        ███
███    ███ ███   ███   ███   ███    ███   ███        ███
 ▀██████▀   ▀█   ███   █▀    ███    █▀    ███        ███
                                          █▀         █▀
  ${RESET}"

  CHOICE=$(gum choose \
    --header "  What would you like to view?" \
    --header.foreground="240" \
    "Commands & Aliases" \
    "OpenCode Quota" \
    "Functions" \
    "Herdr Reference" \
    "Quit")

  case "$CHOICE" in
    "Commands & Aliases") page_commands ;;
    "OpenCode Quota")     page_quota    ;;
    "Functions")          page_functions ;;
    "Herdr Reference")    page_herdr    ;;
    "Quit"|"")            clear; exit 0 ;;
  esac

  echo ""
  gum choose "Back to menu" "Quit" | grep -q "Back to menu" && continue || { clear; exit 0; }
done
