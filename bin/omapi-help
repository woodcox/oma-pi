#!/bin/bash
set -euo pipefail

if ! command -v gum &>/dev/null; then
  echo "Error: gum is not installed or not on PATH"
  exit 1
fi

# Colours
RED="\e[38;2;197;26;74m"
GREEN="\e[32m"
BLUE="\e[34m"
CYAN="\e[36m"
YELLOW="\e[33m"
MAGENTA="\e[35m"
BOLD="\e[1m"
DIM="\e[2m"
RESET="\e[0m"


# Helpers
header() {
  echo -e "${RED}${BOLD}  $1${RESET}"
  echo -e "${DIM}  $(printf '─%.0s' {1..50})${RESET}"
}

section() {
  echo ""
  echo -e "${CYAN}${BOLD}  $1${RESET}"
}

cmd() {
  # cmd "alias" "description"
  printf "  ${GREEN}%-28s${RESET} %s\n" "$1" "$2"
}

hotkey() {
  # hotkey "keys" "description"
  printf "  ${YELLOW}%-28s${RESET} %s\n" "$1" "$2"
}


# Pages
page_commands() {
  clear
  echo ""
  header "Oma-Pi Commands"

  section "Scripts"
  cmd "omapi-help"    "Show this help"
  cmd "omapi-refresh" "Reinstall Oma-Pi with initial configs"
  cmd "omapi-setup"   "Set git name, email and GitHub CLI auth"
  cmd "omapi-ssh"     "Add SSH key for remote access"

  section "AI Tools"
  cmd "c"   "opencode"
  cmd "cx"  "claude --permission-mode bypassPermissions"
  cmd "cy"  "codex -s danger-full-access -a never"

  section "Docker"
  cmd "d"   "docker"
  cmd "lzd" "lazydocker"

  section "Tmux"
  cmd "t"   "tmux attach || tmux new -s Work"
  cmd "ic"  "tdl c"
  cmd "ix"  "tdl cx"
  cmd "icx" "tdl c cx"
  cmd "tdl [ai] [ai2]"               "Dev layout: editor + AI pane(s) + terminal"
  cmd "tdl c"                        "Editor + opencode"
  cmd "tdl cx"                       "Editor + claude"
  cmd "tdl c cx"                     "Editor + opencode + claude"
  cmd "tdlm [ai] [ai2]"              "One tdl window per subdirectory"
  cmd "tds"                          "Dev square: editor + diff watch + opencode"
  cmd "tsl <count> <command>"        "Swarm layout: N panes running same command"

  section "Git"
  cmd "g"    "git"
  cmd "gcm"  "git commit -m"
  cmd "gcam" "git commit -a -m"
  cmd "g co" "git checkout"
  cmd "g br" "git branch"
  cmd "g ci" "git commit"
  cmd "g st" "git status"
  cmd "gh"   "github cli"
  cmd "ga <branch>"                  "Create worktree + branch, cd into it"
  cmd "gd"                           "Remove current worktree + branch"
  cmd "git-id"                       "Set global git user.name and user.email"

  section "File & Navigation"
  cmd "nnn"  "file manager (nnn)"
  cmd "ff"  "fzf fuzzy finder"
  cmd "eff"  "fzf fuzzy finder in editor (MS Edit)"
  cmd "cd"  "zoxide (smart cd)"
  cmd ".."  "cd .."
  cmd "..."  "cd ../.."
  cmd "...."  "cd ../../.."
  cmd "ls"  "eza"
  cmd "lt"  "eza tree (2 levels)"
  cmd "lsa" "eza including hidden"
  cmd "lta" "eza tree including hidden"

  section "SSH Port Forwarding"
  cmd "fip <host> <port...>"           "Forward port(s) from remote host"
  cmd "dip <port...>"                  "Stop forwarding port(s)"
  cmd "lip"                            "List active port forwards"

  section "System"
  cmd "btop" "resource monitor"
  cmd "tldr" "simplified man pages"
}

page_tmux() {
  clear
  echo ""
  header "Tmux Reference"
  echo -e "  ${DIM}Prefix = Ctrl + Space (Ctrl + B also works)${RESET}"
  echo -e "  ${DIM}Only the Alt / Ctrl+Alt keys work without a prefix.${RESET}"

  section "Panes"
  hotkey "Prefix h"            "Split window top/bottom"
  hotkey "Prefix v"            "Split window left/right"
  hotkey "Prefix x"            "Kill pane"
  hotkey "Prefix z"            "Toggle pane zoom"
  hotkey "Prefix Space"        "Cycle pane layouts"
  hotkey "Alt+Enter"           "Split window top/bottom (same as Prefix h)"
  hotkey "Alt+Shift+Enter"     "Split window left/right (same as Prefix v)"
  hotkey "Alt+Escape"          "Kill pane (same as Prefix x)"

  section "Panes - movement"
  hotkey "Ctrl+Alt+Arrow"      "Move between panes"
  hotkey "Ctrl+Alt+Shift+Arrow" "Resize pane by 5"

  section "Windows"
  hotkey "Prefix c"            "New window"
  hotkey "Prefix r"            "Rename window"
  hotkey "Prefix k"            "Kill window"
  hotkey "Prefix w"            "Choose window from list"
  hotkey "Prefix n / p"        "Next / previous window"
  hotkey "Alt+1 .. Alt+9"      "Go to window by number"
  hotkey "Alt+Left / Alt+Right" "Previous / next window"
  hotkey "Alt+Shift+Left / Alt+Shift+Right" "Swap window with previous / next"

  section "Sessions"
  hotkey "Prefix C"            "New session"
  hotkey "Prefix R"            "Rename session"
  hotkey "Prefix K"            "Kill session"
  hotkey "Prefix s"            "Choose session from list"
  hotkey "Prefix d"            "Detach from session"
  hotkey "Prefix P / N"        "Previous / next session"
  hotkey "Alt+Up / Alt+Down"   "Previous / next session"

  section "Copy Mode"
  hotkey "Prefix ["  "Enter copy mode (vi keys)"
  hotkey "v"         "Begin selection (in copy mode)"
  hotkey "y"         "Copy selection and exit (in copy mode)"
  hotkey "Prefix ]"  "Paste from buffer"

  section "Other"
  hotkey "Prefix q"   "Reload tmux config"
  hotkey "Prefix ?"   "Show all key bindings in a popup"
  hotkey "Prefix :"   "Open command prompt"
}

# MS Edit is mode-less and has no published keybinding table, so this is
# deliberately short: the menus are the documentation, F10 opens them. The
# Helix page this replaces was a cheat sheet for a modal editor, and there is
# nothing to replace it with.
page_editor() {
  clear
  echo ""
  header "MS Edit Reference"

  section "Basics"
  hotkey "F10"            "Menus - the editor is mode-less, so this is the reference"
  hotkey "msedit ."       "Open the current directory"
  hotkey "msedit -g f:12" "Open a file at a line"
  hotkey "eff"            "fzf fuzzy find a file and open it in \$EDITOR"

  section "Also installed"
  cmd  "nnn"   "File manager (opens files in \$EDITOR)"
  cmd  "fresh" "Fresh terminal IDE (installed only if you opted in)"
}

page_functions() {
  clear
  echo ""
  header "Functions"

  section "Drives"
  cmd "iso2sd <iso> [device]"        "Write an ISO to an SD card / USB drive"
  cmd "format-drive <device> <name>" "Wipe and format a whole drive as exFAT"

  section "Files"
  cmd "sff <destination>"            "Pick a file with fzf and scp it away"
  cmd "compress <path>"              "tar.gz a file or directory"
  cmd "decompress <file.tar.gz>"     "Extract a tar.gz archive"

  section "Worktrees"
  cmd "ga <branch>"                  "Create worktree + branch, cd into it"
  cmd "gd"                           "Remove current worktree + branch"

  section "SSH Port Forwarding"
  cmd "fip <host> <port...>"         "Forward port(s) from a remote host"
  cmd "dip <port...>"                "Stop forwarding port(s)"
  cmd "lip"                          "List active port forwards"
}



# Main menu
while true; do
  clear
  echo ""
  echo -e "${RED}   
 ▄██████▄    ▄▄▄▄███▄▄▄▄      ▄████████    ▄████████ ▄██
███    ███ ▄██▀▀▀███▀▀▀██▄   ███    ███   ███    ███ █▀
███    ███ ███   ███   ███   ███    ███   ███    ███   ▄
███    ███ ███   ███   ███   ███    ███   ███    ███ ▄██
███    ███ ███   ███   ███ ▀███████████ ▀█████████▀  ███
███    ███ ███   ███   ███   ███    ███   ███        ███
███    ███ ███   ███   ███   ███    ███   ███        ███
 ▀██████▀   ▀█   ███   █▀    ███    █▀    ███        ███
                                          █▀         █▀
  ${RESET}"

  CHOICE=$(gum choose \
    --header "  What would you like to view?" \
    --header.foreground="240" \
    "Commands & Aliases" \
    "Functions" \
    "Tmux Reference" \
    "Editor Reference" \
    "Quit")

  case "$CHOICE" in
    "Commands & Aliases") page_commands ;;
    "Functions")          page_functions ;;
    "Tmux Reference")     page_tmux     ;;
    "Editor Reference")   page_editor   ;;
    "Quit"|"")            clear; exit 0 ;;
  esac

  echo ""
  gum choose "Back to menu" "Quit" | grep -q "Back to menu" && continue || { clear; exit 0; }
done
