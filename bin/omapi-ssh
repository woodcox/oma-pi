#!/bin/bash
set -euo pipefail

# Add SSH public key for remote access

if gum confirm "Add SSH public key for remote access?"; then
  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh"

  SSH_KEY=$(gum input --placeholder "ssh-ed25519 AAAAC3..." --prompt "SSH key: ")

  if [[ -z $SSH_KEY ]]; then
    echo "No key entered, authorized_keys left unchanged."
    exit 1
  fi

  # Validate before writing. A truncated paste or a private key is silently
  # ignored by sshd, and the password auth prompt below would then have
  # switched off the only way back in.
  KEY_FILE=$(mktemp)
  trap 'rm -f "$KEY_FILE"' EXIT
  printf '%s\n' "$SSH_KEY" >"$KEY_FILE"
  if ! ssh-keygen -l -f "$KEY_FILE" >/dev/null 2>&1; then
    echo "Not a valid public key, authorized_keys left unchanged."
    exit 1
  fi
  rm -f "$KEY_FILE"

  # The key is known good, so create the file if it is not there yet and take
  # care that it is not group or world readable. Doing this any earlier left an
  # empty authorized_keys behind on the rejected paths above, which is not the
  # "left unchanged" those paths claim.
  AUTHORIZED_KEYS="$HOME/.ssh/authorized_keys"
  touch "$AUTHORIZED_KEYS"
  chmod 600 "$AUTHORIZED_KEYS"

  if grep -qxF "$SSH_KEY" "$AUTHORIZED_KEYS"; then
    echo "That key is already in authorized_keys."
  else
    # Append. The usual case is one key per device, and overwriting the file
    # locks every other one of them out. An authorized_keys with no final
    # newline would have the new key concatenated onto its last line, turning
    # that entry into rubbish and quietly revoking it, so close the file off
    # first. Only when it is not already newline terminated, so this does not
    # leave a blank line behind.
    if [[ -s $AUTHORIZED_KEYS ]] && [[ -n $(tail -c 1 "$AUTHORIZED_KEYS") ]]; then
      printf '\n' >>"$AUTHORIZED_KEYS"
    fi
    printf '%s\n' "$SSH_KEY" >>"$AUTHORIZED_KEYS"
    echo "SSH key added to authorized_keys ($(grep -c . "$AUTHORIZED_KEYS") total)."
  fi

  # Offer to disable password auth if not already disabled
  if ! grep -q "^PasswordAuthentication no" /etc/ssh/sshd_config 2>/dev/null; then
    if gum confirm "Disable password authentication for SSH (key-based auth only)?"; then
      sudo sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config
      sudo sed -i 's/^#*PubkeyAuthentication.*/PubkeyAuthentication yes/' /etc/ssh/sshd_config
      sudo systemctl restart sshd.service
      echo "SSH configured for key-based authentication only."
    fi
  fi
fi
